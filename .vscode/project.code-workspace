{
  "name": "Dante",
  // Root folders shown in the explorer (paths relative to this file's directory .vscode/)
  "folders": [
    {"path": "../"},                    // /var/www/html/wiki-dir
    {"path": "../extensions/Parsifal"}, // /var/www/html/wiki-dir/extensions/Parsifal
    {"path": "/var/www"}                // /var/www
  ],
  // Workspace-wide settings
  "settings": {
    "git.repositoryScanMaxDepth": 1,
    "git.scanRepositories": ["../extensions/Parsifal"],
    "search.useIgnoreFiles": true,
    // Show ALL files in the explorer: switch off every built-in default exclude and do not hide git-ignored files
    "files.exclude": {
      "**/.git": false,
      "**/.svn": false,
      "**/.hg": false,
      "**/CVS": false,
      "**/.DS_Store": false,
      "**/Thumbs.db": false
    },
    "explorer.excludeGitIgnore": false,
    "workbench.tree.indent": 24,                   // Configure a more reasonable indentation in the editor
    "editor.inlineSuggest.enabled": false,         // Disable inline ghost text suggestions
    "editor.parameterHints.enabled": false,        // Disable the parameter hints popup
    "editor.lightbulb.enabled": "off",             // Disable the code-action lightbulb hover
    "editor.hover.enabled": "off",                 // Disable hover popups
    "editor.suggest.showDetails": false,           // Disable big suggestion detail panel
    "editor.suggest.showStatusBar": false,         // Disable suggestion documentation preview
    "editor.suggest.showWords": false,
    "editor.suggestOnTriggerCharacters": false,    // Make autocomplete less aggressive
  }
}
